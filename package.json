{
  "name": "pulse-max-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests docs README.md *.json *.ts *.html",
    "format:check": "prettier --check src tests docs README.md *.json *.ts *.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
